# ==============================================================================
# Enterprise LangGraph Agent System - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
PROJECT_NAME="Enterprise LangGraph Agent API"
VERSION="1.0.0"

# CORS & Host Whitelist (JSON array or comma-separated strings)
CORS_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]

# ------------------------------------------------------------------------------
# 2. LLM Provider (Groq / OpenAI)
# ------------------------------------------------------------------------------
# Primary LLM API Key (Groq Cloud API)
GROQ_API_KEY=your_groq_api_key_here

# Default Model Identifier (e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile)
DEFAULT_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3

# Optional Fallback Provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. Per-Agent Token Limit Controls (Budget Protections)
# ------------------------------------------------------------------------------
PLANNER_MAX_TOKENS=800
APPROVER_MAX_TOKENS=500
SYNTHESIZER_MAX_TOKENS=1500
FACT_CRITIC_MAX_TOKENS=600
STYLE_CRITIC_MAX_TOKENS=600
PUBLISHER_MAX_TOKENS=2500
GENERIC_CHAT_MAX_TOKENS=1500

# ------------------------------------------------------------------------------
# 4. PostgreSQL Databases (Multi-DB Architecture)
# ------------------------------------------------------------------------------
# Agent & Workflow Checkpoints Database (LangGraph PostgresSaver & Chat History)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_db
DB_URI=postgresql://postgres:postgres@localhost:5432/agent_db
TABLE_NAME=chat_message_history
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=3

# Authentication & User Accounts Database (Users, Token Blacklist, Password Resets)
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db
AUTH_DB_POOL_MIN_SIZE=2
AUTH_DB_POOL_MAX_SIZE=10

# ------------------------------------------------------------------------------
# 5. Security, OAuth2 & JWT Token Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access and reset tokens (Min 32 characters for production)
JWT_SECRET_KEY=change-this-to-a-super-secret-cryptographic-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15

# ------------------------------------------------------------------------------
# 6. Real-Time Web Intelligence & Search Tools
# ------------------------------------------------------------------------------
# DuckDuckGo Live Search Engine (Enabled for parallel researcher agent & ReAct tools)
ENABLE_DDG_SEARCH=True

# Optional Tavily API Search Tool
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 7. Langfuse Observability & Tracing (Optional)
# ------------------------------------------------------------------------------
LANGFUSE_ENABLED=False
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 8. Model Context Protocol (MCP) & Multi-Agent Intelligence Settings
# ------------------------------------------------------------------------------
# Airbnb Stdio MCP Server (@openbnb/mcp-server-airbnb)
ENABLE_AIRBNB_MCP=True
AIRBNB_MCP_COMMAND=npx
AIRBNB_MCP_ARGS=["-y", "@openbnb/mcp-server-airbnb", "--ignore-robots-txt"]

# Pinecone Stdio MCP Server (@pinecone-database/mcp)
ENABLE_PINECONE_MCP=True
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=hpvdb-openai
PINECONE_MCP_COMMAND=npx
PINECONE_MCP_ARGS=["-y", "@pinecone-database/mcp"]

# Vector DB Migration (Qdrant to Pinecone serverless)
QDRANT_ENDPOINT=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# WeatherAPI.com Key (Optional - free Open-Meteo fallback is used if omitted)
WEATHER_API_KEY=your_weatherapi_key_here

# MCP Multi-Agent Token Budgets
AIRBNB_AGENT_MAX_TOKENS=4096
HP_AGENT_MAX_TOKENS=4096
WEATHER_AGENT_MAX_TOKENS=2048
TOUR_AGENT_MAX_TOKENS=4096
